# 反思之旅 V0.4 — 服务端模型配置
# 复制为 .env.local 后填写。不要把 .env.local 提交到 Git。

# 默认 Provider：deepseek / openai / glm / custom
AI_PROVIDER=deepseek

# DeepSeek（V0.4 默认推荐）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# OpenAI（可选对照）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# GLM / 智谱（可选；模型名请按你账号控制台当前可用模型填写）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=
# 如果你确认当前 GLM 模型支持 OpenAI-compatible response_format=json_object，可改为 true
GLM_JSON_MODE=false

# 其他 OpenAI-compatible Provider（可选）
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
CUSTOM_AI_JSON_MODE=true
