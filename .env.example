# 反思之旅 V0.10 — AI 参与决策、服务端账户与社区配置
# V0.6 同时使用服务端账户与公开卡片数据库；这些字段不进入浏览器打包。
COMMUNITY_DB_PATH=./data/community.sqlite
AI_DAILY_LIMIT=80
AI_MINUTE_LIMIT=8
AI_GLOBAL_DAILY_LIMIT=500
# 默认允许直连此电脑 localhost 的访客使用已配置 AI；公网与代理访问仍须登录。
# 设置为 false 可关闭本机访客调用。设置 AI_LOCAL_ONLY=true 则禁用全部模型。
AI_ALLOW_LOCAL_GUEST=true
# 本机默认即可。公网使用 HTTPS，并填写实际网站 Origin。
APP_ORIGIN=
COOKIE_SECURE=false
# 可选：公开试用时设置邀请码，仅知道邀请码的人可以注册。
COMMUNITY_INVITE_CODE=
# 推荐：已建立运营账户的完整 ID，多个用英文逗号分隔。留空时不按 ID 授权。
COMMUNITY_MODERATOR_IDS=
# 兼容旧配置：仅在启动时绑定已存在的账号；未建立的名字禁止公众注册。
COMMUNITY_MODERATOR_USERS=
# 可选：命令行竞技场凭据，只在本机服务端和 CLI 读取。
RJ_ARENA_TOKEN=
# 复制为 .env.local 后填写。不要把 .env.local 提交到 Git。

# 默认 Provider：deepseek / openai / glm / custom
AI_PROVIDER=deepseek

# DeepSeek（模型名请以服务商当前可用配置为准）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 互动对话默认 disabled，避免隐藏推理耗尽结构化输出预算；也可明确设为 enabled。
DEEPSEEK_THINKING_MODE=disabled

# OpenAI（可选对照）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# GLM / 智谱（可选；模型名请按你账号控制台当前可用模型填写）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=
# 如果你确认当前 GLM 模型支持 OpenAI-compatible response_format=json_object，可改为 true
GLM_JSON_MODE=false

# 其他 OpenAI-compatible Provider（可选）
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
CUSTOM_AI_JSON_MODE=true
